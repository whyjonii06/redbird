# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
.turbo/
*.tsbuildinfo

# Vite app sources are TS/TSX only — a same-named .js next to a .tsx is always a stray
# compiled artifact (Vite/Node resolve the literal .js before the .tsx sibling, so a
# stale one silently shadows real source edits).
apps/marketplace/src/**/*.js
apps/storefront/src/**/*.js
apps/backoffice/src/**/*.js

# Test
coverage/
.vitest-cache/

# Env
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Postgres data (Docker volume)
.postgres-data/

# PGlite file-based dev database (DATABASE_URL=file:...)
*.pglite/

# Runtime state (store-specific, not part of the repo)
redbird.meta.json
packages/api/redbird.meta.json
packages/api/redbird.config.ts

# Claude AI internal
.claude/

# SQLite databases
*.db
*.db-shm
*.db-wal
VPS.txt
nginx-redbirdshop.conf
packages/api/themes/*.zip
