{
  "name": "@redbirdshop/api",
  "version": "0.1.1",
  "license": "MIT",
  "description": "Redbird API — type-safe tRPC router for catalog, cart, orders",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./router": {
      "types": "./dist/routers/index.d.ts",
      "import": "./dist/routers/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "serve": "tsx watch src/dev.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@redbird/plugin-reviews": "workspace:*",
    "@redbirdshop/core": "workspace:*",
    "@redbirdshop/trpc": "workspace:*",
    "@trpc/server": "^11.0.0-rc.660",
    "@types/pdfkit": "^0.17.6",
    "pdfkit": "^0.19.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@redbird/plugin-analytics": "workspace:*",
    "@redbird/plugin-email-local": "workspace:*",
    "@redbird/plugin-email-resend": "workspace:*",
    "@redbird/plugin-email-smtp": "workspace:*",
    "@redbird/plugin-paypal": "workspace:*",
    "@redbird/plugin-shipping-flat": "workspace:*",
    "@redbird/plugin-shipping-mondial-relay": "workspace:*",
    "@redbird/plugin-stripe": "workspace:*",
    "@redbird/plugin-vat-eu": "workspace:*",
    "drizzle-orm": "^0.36.4"
  }
}
