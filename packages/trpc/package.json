{
  "name": "@redbirdshop/trpc",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Shared tRPC foundation — context type, procedures and rate limiting, consumed by the API and by modules so both build against the same typed context",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@redbirdshop/core": "workspace:*",
    "@trpc/server": "^11.0.0-rc.660"
  }
}
